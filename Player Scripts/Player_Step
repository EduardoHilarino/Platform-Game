
/// =======================================
/// 1. ENTRADAS
/// =======================================

var move = keyboard_check(ord("D"))
         - keyboard_check(ord("A"));

var jump_pressed = keyboard_check_pressed(vk_space);
var jump_held = keyboard_check(vk_space);


/// =======================================
/// 2. MOVIMENTO HORIZONTAL
/// =======================================

var target_hsp = move * max_hsp;
var rate = acceleration;

if (move == 0) {
    rate = deceleration;
}
else if (hsp != 0 && sign(hsp) != move) {
    rate = turn_acceleration;
}

// Aproxima a velocidade atual da desejada
if (hsp < target_hsp) {
    hsp = min(hsp + rate, target_hsp);
}
else if (hsp > target_hsp) {
    hsp = max(hsp - rate, target_hsp);
}


/// =======================================
/// 3. VERIFICAÇÃO DO CHÃO
/// =======================================

grounded = place_meeting(x, y + 1, Obj_Solid);

// Atualizar coyote time
if (grounded) {
    coyote_timer = coyote_frames;
}
else {
    coyote_timer = max(0, coyote_timer - 1);
}


/// =======================================
/// 4. JUMP BUFFER
/// =======================================

if (jump_pressed) {
    jump_buffer = buffer_frames;
}
else {
    jump_buffer = max(0, jump_buffer - 1);
}


/// =======================================
/// 5. EXECUTAR PULO
/// =======================================

if (jump_buffer > 0 && coyote_timer > 0) {

    vsp = jump_speed;

    jump_buffer = 0;
    coyote_timer = 0;

    grounded = false;
}


/// =======================================
/// 6. GRAVIDADE DINÂMICA
/// =======================================

if (!grounded || vsp < 0) {

    if (vsp < 0) {

        if (jump_held) {
            vsp += gravity_up;
        }
        else {
            vsp += gravity_cut;
        }

    }
    else {
        vsp += gravity_down;
    }

    vsp = min(vsp, max_fall_speed);

}
else {
    vsp = 0;
}


/// =======================================
/// 7. COLISÃO HORIZONTAL
/// =======================================

// Acumular movimento fracionário
x_remainder += hsp;

// Extrair apenas pixels inteiros
var move_x = floor(abs(x_remainder))
           * sign(x_remainder);

x_remainder -= move_x;

// Aplicar movimento pixel por pixel
repeat (abs(move_x)) {

    var dir_x = sign(move_x);

    if (!place_meeting(x + dir_x, y, Obj_Solid)) {
        x += dir_x;
    }
    else {
        hsp = 0;
        x_remainder = 0;
        break;
    }
}


/// =======================================
/// 8. COLISÃO VERTICAL
/// =======================================

// Acumular movimento fracionário
y_remainder += vsp;

// Extrair apenas pixels inteiros
var move_y = floor(abs(y_remainder))
           * sign(y_remainder);

y_remainder -= move_y;

// Aplicar movimento pixel por pixel
repeat (abs(move_y)) {

    var dir_y = sign(move_y);

    if (!place_meeting(x, y + dir_y, Obj_Solid)) {
        y += dir_y;
    }
    else {
        vsp = 0;
        y_remainder = 0;
        break;
    }
}
